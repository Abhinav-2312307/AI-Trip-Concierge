# ==============================================================================
# 🌴 AI Trip Concierge - Backend Render & Production Environment Variables
# ==============================================================================
# The backend works 100% in zero-key offline concierge mode even without API keys!
# You can set any of the optional keys below directly in your Render Dashboard:
# Dashboard -> Service -> Environment -> Add Environment Variable
# ==============================================================================

# Server Configuration (Render automatically sets PORT)
HOST=0.0.0.0
PORT=8000
PYTHON_VERSION=3.11.8

# OPTION 1 (Recommended & 100% Free): Google Gemini API Key
# https://aistudio.google.com/
GEMINI_API_KEY=

# OPTION 2 (Free & Ultra Fast): Groq Cloud API Key
# https://console.groq.com/
GROQ_API_KEY=

# OPTION 3: Anthropic Claude API Key (Optional)
# https://console.anthropic.com/
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# OPTION 4: OpenAI API Key (Optional)
OPENAI_API_KEY=
